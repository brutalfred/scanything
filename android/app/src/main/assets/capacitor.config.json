{
  "appId": "app.scanything.scanything",
  "appName": "Scanything",
  "webDir": "dist/client",
  "android": {
    "allowMixedContent": false,
    "appendUserAgent": "ScanythingAndroid"
  },
  "server": {
    "url": "https://scanything.app",
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#000000",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000"
    }
  }
}
